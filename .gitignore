# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments (root-anchored: only top-level ``env/`` dirs are
# virtualenvs; nested ``env/`` directories such as ``Phase4_MARL/env/`` are
# real package code). ``venv`` is never a legitimate package name, so the
# nested pattern ``**/venv/`` is safe and covers Phase3_GraphRAG/venv/ etc.
# (Opus 4.8 audit, B4 finding: fresh-clone hygiene.)
/venv/
/.venv/
/_venv*/
**/venv/
**/.venv/
/env/
/ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints/

# Environment variables (NEVER commit credentials)
.env
.env.*
*.env
# ...but always track example/template files
!.env.example
!**/.env.example

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble

# Windows
Thumbs.db
desktop.ini

# Neo4j local data
neo4j_data/
neo4j_logs/

# Large model / embedding cache
*.bin
*.pt
*.ckpt
sentence_transformers/
.cache/

# Logs
*.log
logs/

# Testing cache
.pytest_cache/
pytest-cache-files-*

# Trained model artefacts (large binaries, re-train from scripts)
*.zip
models/
# Claude Code personal settings (never commit)
.claude/settings.local.json
.claude/.credentials.json
# Ablation run side artefacts (PPO logger stderr + Start-Process PID file)
*.err
*.pid

# Local Documents folder accidentally included in repo (Windows ~/Documenti)
Documenti/

# TensorBoard event logs (binary, noisy on diff)
**/runs/
*.tfevents.*

# Phase 3 exploratory probes (underscore-prefixed scripts and intermediate dumps)
# These are kept locally for reproducibility but excluded from the public repo.
# Comment the following two lines if you want to commit them.
Phase3_GraphRAG/_*.py
Phase3_GraphRAG/results/_*

# Phase 3 cache directory
Phase3_GraphRAG/cache/
