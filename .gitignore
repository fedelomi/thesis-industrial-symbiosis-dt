# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments (root-anchored: only top-level dirs are virtualenvs;
# nested ``env/`` directories such as ``Phase4/env/`` are real package code).
/venv/
/.venv/
/_venv*/
/env/
/ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints/

# Environment variables (NEVER commit credentials)
.env
.env.*
*.env
# ...but always track example/template files
!.env.example
!**/.env.example

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble

# Windows
Thumbs.db
desktop.ini

# Neo4j local data
neo4j_data/
neo4j_logs/

# Large model / embedding cache
*.bin
*.pt
*.ckpt
sentence_transformers/
.cache/

# Logs
*.log
logs/

# Testing cache
.pytest_cache/
pytest-cache-files-*

# Trained model artefacts (large binaries, re-train from scripts)
*.zip
models/
# Claude Code personal settings (never commit)
.claude/settings.local.json
.claude/.credentials.json
# Ablation run side artefacts (PPO logger stderr + Start-Process PID file)
*.err
*.pid

